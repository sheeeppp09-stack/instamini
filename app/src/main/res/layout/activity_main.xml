<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_dm"
            style="@style/Tab"
            android:text="@string/tab_dm" />

        <TextView
            android:id="@+id/tab_stories"
            style="@style/Tab"
            android:text="@string/tab_stories" />

        <TextView
            android:id="@+id/tab_settings"
            style="@style/Tab"
            android:text="@string/tab_settings" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/settings_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/cache_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cache_calculating"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="@string/cache_note"
                android:textColor="@color/gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/cache_clear"
                style="@style/Btn"
                android:text="@string/cache_clear" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
